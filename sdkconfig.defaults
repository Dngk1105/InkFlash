# InkFlash v2 — cấu hình mặc định (ESP-IDF v6.1, ESP32-S3-WROOM-1-N16R8)
# sdkconfig được sinh ra từ file này. Đã có sdkconfig thì giá trị trong đó thắng: đổi mặc định xong phải xoá sdkconfig.
CONFIG_IDF_TARGET="esp32s3"

# Flash 16MB, PSRAM 8MB octal (chiếm GPIO35–37)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y

# Bảng phân vùng riêng (docs/firmware/partitions.md)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Chịu lỗi: core dump vào flash, OTA rollback, Task Watchdog
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_TASK_WDT_EN=y

# Console qua cổng USB tích hợp (GPIO19/20)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Tick 1 ms (đo thời gian chính xác), stack main đủ cho chuỗi khởi động
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Lệnh console `tasks` (vTaskList)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# Bắt lỗi ghi tràn heap khi phát triển (docs/adr/0003-cap-phat-dong.md)
CONFIG_HEAP_POISONING_LIGHT=y

# Board
CONFIG_INK_BOARD_BREADBOARD_GD0=y
