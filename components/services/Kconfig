menu "InkFlash services"

    config INK_SVC_POWER
        bool "Power & sleep management (svc_power)"
        default y
        help
            Quản lý nguồn, nút bấm điều khiển ngủ sâu (2s) và ship mode (8s).

    config INK_SVC_GUI
        bool "GUI & e-paper display (svc_gui)"
        default y
        help
            Dịch vụ vẽ giao diện, thẻ flashcard lên màn hình e-paper.

    config INK_SVC_STORAGE
        bool "Storage & flashcard SRS (svc_storage)"
        default n
        help
            Lưu trữ flashcard trên LittleFS và thuật toán ôn tập lặp lại ngắt quãng (FSRS).

    config INK_SVC_AUDIO
        bool "Audio playback & recording (svc_audio)"
        default n
        help
            Dịch vụ phát âm thanh (MAX98357A) và ghi âm từ micro (INMP441).

    config INK_SVC_AI
        bool "On-device AI speech recognition (svc_ai)"
        default n
        help
            Nhận diện giọng nói offline với ESP-SR MultiNet7.

    config INK_SVC_GESTURE
        bool "IMU gesture recognition (svc_gesture)"
        default n
        help
            Nhận diện cử chỉ lật, úp mặt hoặc xoay màn hình từ IMU.

endmenu
