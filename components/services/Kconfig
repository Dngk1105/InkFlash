    config INK_DEMO
        bool "Demo benchmark e-paper + IMU + loa (svc_demo)"
        default y
        help
            Chạy demo đo tốc độ làm mới màn e-paper, theo dõi góc nghiêng IMU, phát tiếng bíp.
