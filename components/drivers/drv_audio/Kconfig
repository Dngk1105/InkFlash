menu "InkFlash audio drivers"

    choice INK_MIC_DRIVER
        prompt "Mic driver"
        default INK_MIC_FAKE
        config INK_MIC_NONE
            bool "Không có mic"
        config INK_MIC_FAKE
            bool "Giả lập (im lặng)"
        config INK_MIC_INMP441
            bool "INMP441 (I2S)"
    endchoice

    choice INK_SPEAKER_DRIVER
        prompt "Speaker driver"
        default INK_SPEAKER_FAKE
        config INK_SPEAKER_NONE
            bool "Không có loa"
        config INK_SPEAKER_FAKE
            bool "Giả lập (bỏ dữ liệu)"
        config INK_SPEAKER_MAX98357A
            bool "MAX98357A (amp I2S)"
    endchoice

endmenu
