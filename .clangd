# Firmware: cờ build của ESP-IDF (gcc Xtensa), lấy từ build/compile_commands.json.
If:
  PathExclude: .*/test/.*\.c
CompileFlags:
  CompilationDatabase: build
  Add:
    - -isystemC:/Espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/picolibc/include
    - -isystemC:/Espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/15.2.0/include
    - -isystemC:/Espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/15.2.0/include-fixed
    - -isystemC:/Espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/xtensa-esp-elf/include
    - --target=xtensa-esp-elf
  Remove: [-f*, -m*]

---
# Host test (*/test/*.c): build bằng gcc trên PC, lấy từ build-host/compile_commands.json (test/host).
If:
  PathMatch: .*/test/.*\.c
CompileFlags:
  CompilationDatabase: build-host

---
Diagnostics:
  UnusedIncludes: None
