{
  "idf.extensionActivationMode": "always",
  "idf.openOcdConfigs": [
    "board/esp32s3-builtin.cfg"
  ],
  "idf.port": "COM4",
  "idf.currentSetup": "C:\\esp\\v6.1\\esp-idf",
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32s3"
  },
  "idf.buildPath": "${workspaceFolder}/build",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=C:/Espressif/tools/**"
  ],
  "clangd.path": "C:\\Espressif\\tools\\esp-clangd\\esp-21.1.3_20260408\\esp-clangd\\bin\\clangd.exe",
  "idf.flashType": "UART",
  "cmake.cmakePath": "cmake",
  "editor.fontFamily": "\"Cascadia Code\", monospace",
  "files.associations": {
    "CMakeLists.txt": "cmake",
    "*.cmake": "cmake",
    ".clangd": "yaml",
    "*.h": "c"
  },
  "doxdocgen.generic.order": [
    "brief",
    "custom",
    "param",
    "return"
  ],
  "doxdocgen.generic.briefTemplate": "@brief {text}",
  "doxdocgen.generic.generateSmartText": false,
  "doxdocgen.generic.customTags": [
    "@par Called from",
    ""
  ],
  "doxdocgen.generic.paramTemplate": "@param {param} ",
  "doxdocgen.generic.returnTemplate": "@retval {type} ",
  "doxdocgen.generic.includeTypeAtReturn": false,
  "doxdocgen.generic.boolReturnsTrueFalse": true,
  "better-todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "BUG",
    "HACK",
    "PERF",
    "REVIEW",
    "EXTEND",
    "WARN",
    "NOTE"
  ],
  "better-todo-tree.regex.regex": "((//|#|<!--|;|/\\*|^\\s*\\*|^)\\s*($TAGS))",
  "better-todo-tree.filtering.includeGlobs": [
    "**/main/**",
    "**/components/**",
    "**/templates/**",
    "**/tools/*.py",
    "**/test/**"
  ],
  "better-todo-tree.filtering.excludeGlobs": [
    "**/build/**",
    "**/build-host/**",
    "**/managed_components/**"
  ],
  "better-todo-tree.tree.showCountsInTree": true,
  "better-todo-tree.tree.groupedByTag": true,
  "better-todo-tree.highlights.defaultHighlight": {
    "type": "tag",
    "gutterIcon": true,
    "fontWeight": "bold",
    "opacity": 15,
    "borderRadius": "3px"
  },
  "better-todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "checklist",
      "foreground": "#268BD2",
      "background": "#268BD2",
      "iconColour": "#268BD2",
      "rulerColour": "#268BD2"
    },
    "FIXME": {
      "icon": "tools",
      "foreground": "#DC322F",
      "background": "#DC322F",
      "iconColour": "#DC322F",
      "rulerColour": "#DC322F"
    },
    "BUG": {
      "icon": "bug",
      "foreground": "#D33682",
      "background": "#D33682",
      "iconColour": "#D33682",
      "rulerColour": "#D33682"
    },
    "HACK": {
      "icon": "flame",
      "foreground": "#B58900",
      "background": "#B58900",
      "iconColour": "#B58900",
      "rulerColour": "#B58900"
    },
    "PERF": {
      "icon": "zap",
      "foreground": "#2AA198",
